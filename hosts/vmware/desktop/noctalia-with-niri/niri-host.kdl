// Host specific niri settings for the noctalia-with-niri desktop on vmware.
//
// Included last by the shared config, so these values win. The mode and scale
// match what the session used before the config became declarative, which keeps
// the desktop at the size it already had.

output "Virtual-1" {
    mode "2048x1152@60.000"
    scale 1.5
    position x=0 y=0
}
